/* ============================================================
   Engineering Cockpit — Layout, glass components, widgets
   ============================================================ */

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body { height: 100%; }

body {
  font-family: var(--font-ui);
  color: var(--text-primary);
  background: var(--page-bg);
  overflow-x: hidden;
}

/* Ambient background: soft color fields behind the glass */
.ambient {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
}
.ambient::before,
.ambient::after,
.ambient .blob {
  content: "";
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
}
.ambient::before {
  width: 55vw; height: 55vw;
  top: -18vw; right: -12vw;
  background: var(--ambient-1);
}
.ambient::after {
  width: 45vw; height: 45vw;
  bottom: -15vw; left: -10vw;
  background: var(--ambient-2);
}
.ambient .blob {
  width: 35vw; height: 35vw;
  top: 40%; left: 42%;
  background: var(--ambient-3);
}

/* ---------- Glass base component ---------- */
.glass {
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--glass-shadow);
}

/* ---------- App frame ---------- */
.app {
  max-width: 1680px;
  margin: 0 auto;
  padding: var(--gap);
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  min-height: 100vh;
}

/* ---------- Topbar ---------- */
.topbar {
  position: sticky;
  top: var(--gap);
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 20px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-right: 6px;
}
.brand-mark {
  width: 34px; height: 34px;
  border-radius: 11px;
  background: linear-gradient(135deg, var(--series-1), var(--series-7));
  display: grid;
  place-items: center;
  color: #fff;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.02em;
  flex: none;
}
.brand-name { font-size: 15px; font-weight: 650; }
.brand-name small {
  display: block;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-muted);
}

.topbar .spacer { flex: 1; }

/* Portal entrance — deliberately NOT an icon button: it navigates
   to intelligence.html, it doesn't toggle a drawer, and it must not
   be confusable with the assistant toggles on the right. */
.portal-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex: none;
  font: 650 12px/1 var(--font-ui);
  letter-spacing: 0.05em;
  color: #fff;
  background: var(--ai-gradient);
  border-radius: 999px;
  padding: 10px 14px;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 2px 12px rgba(42, 120, 214, 0.35);
}
.portal-pill:hover { filter: brightness(1.1); }
.portal-pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Narrow screens: the bar wraps into rows instead of clipping.
   The ask bar gets its own full-width row below the controls. */
@media (max-width: 1340px) {
  .topbar { flex-wrap: wrap; gap: 10px; }
  .topbar .spacer { display: none; }
  .ask-bar { order: 10; flex: 1 1 100%; max-width: none; }
}
@media (max-width: 900px) {
  .topbar { padding: 10px 14px; }
  .brand-name small { display: none; }
  .portal-label { display: none; }
  .portal-pill { padding: 10px 12px; }
  .user-chip { display: none; }
  .ops-clock:empty { display: none; }
}
/* Phones: one compact row of essentials + the ask bar. Mode toggles
   (ops, boardroom, review, print, feedback) are desktop rituals —
   on a phone you check, you don't chair. */
@media (max-width: 640px) {
  .topbar { padding: 8px 10px; gap: 6px; top: 6px; }
  .brand { margin-right: 0; }
  .brand-name { display: none; }
  .brand-mark { width: 30px; height: 30px; font-size: 13px; }
  #feedback-toggle, #review-toggle, #print-toggle,
  #ops-toggle, #boardroom-toggle, #catalog-toggle, .ops-clock { display: none; }
  .topbar .pill { padding: 8px 8px; font-size: 12px; flex: 0 1 auto; min-width: 0; }
  .topbar select.pill { max-width: 27vw; text-overflow: ellipsis; }
  #sel-range, #sel-asof { display: none; }   /* time travel is a desktop review tool */
  .icon-btn { width: 34px; height: 34px; }
  .ask-bar { min-width: 0; }
}

/* Filter pills (programme / department / time range) */
.pill {
  appearance: none;
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  color: var(--text-primary);
  font: 500 13px/1 var(--font-ui);
  border-radius: var(--radius-md);
  padding: 9px 14px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.pill:hover { border-color: var(--accent); }
.pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

.icon-btn {
  width: 36px; height: 36px;
  border-radius: var(--radius-md);
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  color: var(--text-secondary);
  display: grid;
  place-items: center;
  cursor: pointer;
  font-size: 16px;
  transition: color 0.15s, border-color 0.15s;
}
.icon-btn:hover { color: var(--text-primary); border-color: var(--accent); }
.icon-btn.active { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }

/* ---------- Context row ---------- */
.context-row {
  display: flex;
  align-items: baseline;
  gap: 14px;
  padding: 0 6px;
  flex-wrap: wrap;
}
.context-row h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; }
.context-row .meta { font-size: 13px; color: var(--text-muted); }
.context-row .spacer { flex: 1; }

.chip-row { display: flex; gap: 8px; flex-wrap: wrap; }
.chip {
  font: 500 12px/1 var(--font-ui);
  color: var(--text-secondary);
  border: 1px solid var(--hairline);
  background: var(--glass-bg);
  border-radius: 999px;
  padding: 7px 12px;
  cursor: pointer;
  transition: all 0.15s;
}
.chip.active {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--accent-soft);
  font-weight: 600;
}

/* ---------- Dashboard grid (12 columns) ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: var(--gap);
  align-items: stretch;
}
.w-2  { grid-column: span 2; }
.w-3  { grid-column: span 3; }
.w-4  { grid-column: span 4; }
.w-6  { grid-column: span 6; }
.w-8  { grid-column: span 8; }
.w-12 { grid-column: span 12; }

@media (max-width: 1200px) {
  .w-2 { grid-column: span 4; }
  .w-3 { grid-column: span 6; }
  .w-4, .w-6, .w-8 { grid-column: span 12; }
}
@media (max-width: 640px) {
  .w-2, .w-3 { grid-column: span 12; }
}

/* ---------- Cards / widgets ---------- */
.card {
  padding: var(--pad-card);
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}
.card-head {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.card-head .titles { min-width: 0; flex: 1; }
.card-title { font-size: 14px; font-weight: 650; }
.card-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

/* ---------- KPI tile ---------- */
.kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}
.kpi-value {
  font-size: 34px;
  font-weight: 700;
  letter-spacing: -0.02em;
}
.kpi-unit { font-size: 15px; font-weight: 500; color: var(--text-muted); }
.kpi-delta {
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}
.kpi-delta.good { color: var(--delta-good-text); }
.kpi-delta.bad  { color: var(--delta-bad-text); }
.kpi-delta .vs { font-weight: 400; color: var(--text-muted); }

.kpi-spark { width: 100%; height: 40px; }
.kpi-spark svg { display: block; width: 100%; height: 100%; }

/* Status badge: icon + label, never color alone */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font: 600 11px/1 var(--font-ui);
  border-radius: 999px;
  padding: 5px 10px;
  color: var(--text-primary);
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  flex: none;
}
.status-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
.status-good     .status-dot { background: var(--status-good); }
.status-warning  .status-dot { background: var(--status-warning); }
.status-serious  .status-dot { background: var(--status-serious); }
.status-critical .status-dot { background: var(--status-critical); }
/* kpiquery spec severities (§2.1/2.2): achieved/on_track/overdue */
.status-achieved .status-dot { background: var(--status-good); }
.status-on_track .status-dot { background: var(--status-ontrack); }
.status-overdue  .status-dot { background: var(--status-critical); }

/* ---------- Charts ---------- */
.chart-body { position: relative; flex: 1; min-height: 220px; }
.chart-body svg { display: block; width: 100%; height: 100%; }

.legend {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 12px;
  color: var(--text-secondary);
}
.legend-item { display: inline-flex; align-items: center; gap: 6px; }
.legend-swatch { width: 10px; height: 10px; border-radius: 3px; flex: none; }
.legend-line { width: 14px; height: 2px; border-radius: 1px; flex: none; }

.tooltip {
  position: absolute;
  pointer-events: none;
  background: var(--glass-bg-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--glass-shadow);
  padding: 8px 10px;
  font-size: 12px;
  color: var(--text-primary);
  z-index: 10;
  opacity: 0;
  transition: opacity 0.1s;
  white-space: nowrap;
}
.tooltip.visible { opacity: 1; }
.tooltip .tt-title { font-weight: 650; margin-bottom: 4px; }
.tooltip .tt-row { display: flex; align-items: center; gap: 6px; color: var(--text-secondary); }
.tooltip .tt-row b { color: var(--text-primary); font-variant-numeric: tabular-nums; margin-left: auto; padding-left: 12px; }
.tooltip .tt-desc {
  max-width: 260px; white-space: normal;
  color: var(--text-muted); font-size: 11px; line-height: 1.4;
  margin: 0 0 5px;
}
.tooltip .tt-dep { padding-left: 12px; font-size: 11px; }
/* An input that already lands after the date its successor holds */
.tooltip .tt-row b.tt-late { color: var(--status-critical); }
.tooltip .tt-dep:first-of-type { margin-top: 1px; }

/* ---------- Lists (risks / issues / actions) ---------- */
.list { display: flex; flex-direction: column; }
.list-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 2px;
  border-bottom: 1px solid var(--glass-inner-line);
  font-size: 13px;
}
.list-item:last-child { border-bottom: 0; }
.list-item .li-main { flex: 1; min-width: 0; }
.list-item .li-title {
  font-weight: 550;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.list-item .li-sub { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
/* The one input whose recovery actually moves its successor */
.li-drives {
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.04em; color: var(--accent);
  padding: 1px 5px; border-radius: 4px; background: var(--accent-soft);
}
.list-item .li-value {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  color: var(--text-secondary);
  flex: none;
}

/* ---------- Heatmap ---------- */
.heatmap { overflow-x: auto; }
.heatmap table { border-collapse: separate; border-spacing: 3px; width: 100%; }
.heatmap th {
  font: 500 11px var(--font-ui);
  color: var(--text-muted);
  text-align: center;
  padding: 4px 6px;
}
.heatmap th.row-label { text-align: left; white-space: nowrap; }
.heatmap td {
  border-radius: 8px;
  text-align: center;
  font: 600 11px/1 var(--font-ui);
  padding: 9px 6px;
  min-width: 52px;
  cursor: default;
}
.heatmap td.heat-cell-btn { cursor: pointer; transition: filter 0.12s ease, box-shadow 0.12s ease; }
.heatmap td.heat-cell-btn:hover { filter: brightness(1.06) saturate(1.25); box-shadow: 0 2px 10px rgba(23, 35, 61, 0.14); }
.heatmap td.heat-cell-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.heatmap td.heat-active { outline: 2px solid var(--accent); outline-offset: 1px; }

/* Cell popover: the drivers behind a health-matrix status */
.heat-popover { width: 300px; }
.heat-pop-head {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 8px 5px; font-size: 12.5px;
}
.heat-pop-head b { flex: 1; }
.heat-pop-note { font-size: 11.5px; line-height: 1.4; color: var(--text-muted); padding: 4px 8px 6px; }
.pop-sec {
  font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--text-muted);
  padding: 8px 8px 2px;
}
.pop-kind {
  flex: none;
  font-size: 8.5px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--text-muted);
  border: 1px solid var(--hairline);
  border-radius: 5px;
  padding: 2px 4px;
}
.heat-pop-foot {
  display: flex; gap: 6px;
  padding: 7px 8px 3px; margin-top: 3px;
  border-top: 1px solid var(--glass-inner-line);
}

/* ---------- Equipment & work packages ---------- */
/* Column flow rather than a grid: group cards differ wildly in height
   (a CDR covers dozens of items, a supplier gate two), and grid rows
   would align to the tallest card and leave holes. */
.eq-groups {
  columns: 260px;
  column-gap: 12px;
}
.eq-groups > .eq-group { break-inside: avoid; margin-bottom: 12px; }
.eq-group {
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  border-radius: var(--radius-lg);
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.eq-group-head {
  display: flex; align-items: center; gap: 8px;
  padding: 2px 4px 6px;
  border-bottom: 1px solid var(--glass-inner-line);
  margin-bottom: 4px;
}
.eq-group-name { font-size: 12.5px; font-weight: 650; flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.eq-group-meta { font-size: 10.5px; color: var(--text-muted); flex: none; }
.eq-toolbar { margin-bottom: 2px; }
.tl-sep-label {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--text-muted); margin-right: 2px;
}

/* Multi-select picker (equipment types, key milestones) */
.eq-picker { width: 290px; max-height: 320px; }
.eq-pick-row {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 8px; border-radius: 8px;
  font: 500 12px var(--font-ui); cursor: pointer;
}
.eq-pick-row:hover { background: var(--accent-soft); }
.eq-pick-row input { accent-color: var(--accent); flex: none; }
.eq-pick-count { flex: none; }

/* Severity mix for groups too large to list in full */
.eq-summary { display: flex; align-items: center; gap: 8px; padding: 2px 4px 6px; }
.eq-sum-part { display: flex; flex: 1; }
.eq-summary > .eq-sum-part { min-width: 0; }
.eq-sum-part i { height: 4px; border-radius: 2px; display: block; width: 100%; }
.eq-sum-text { font-size: 10px; color: var(--text-muted); flex: none; }

/* Gate header shown when equipment is grouped by key milestone */
.eq-gate {
  display: flex; align-items: baseline; gap: 8px;
  border: 0; background: none; cursor: pointer;
  font: inherit; color: inherit; text-align: left;
  padding: 2px 4px 6px;
  border-radius: 8px;
}
.eq-gate:hover { background: var(--accent-soft); }
.eq-gate:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.eq-gate-date { font-size: 11.5px; font-weight: 650; font-variant-numeric: tabular-nums; }
.eq-gate-slip { font-size: 10.5px; }
.eq-gate-slip.good { color: var(--delta-good-text); }
.eq-gate-slip.late { color: var(--delta-bad-text); font-weight: 600; }

.eq-item {
  display: flex; align-items: center; gap: 8px;
  border: 0; background: none; cursor: pointer;
  font: inherit; color: inherit; text-align: left;
  padding: 6px 4px; border-radius: 8px;
  min-width: 0;
}
.eq-item:hover { background: var(--accent-soft); }
.eq-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.eq-item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.eq-item-title { font-size: 12px; font-weight: 550;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.eq-item-sub { font-size: 10.5px; color: var(--text-muted);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.eq-src {
  flex: none;
  font-size: 8.5px; font-weight: 700; letter-spacing: 0.06em;
  border-radius: 5px; padding: 2px 4px;
  border: 1px solid var(--hairline);
  color: var(--text-muted);
}
.eq-src-sfe { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }

/* Development projects: phase progress bar */
.prj-bar {
  height: 5px; border-radius: 3px;
  background: var(--accent-soft);
  margin-top: 6px; overflow: hidden;
}
.prj-bar span { display: block; height: 100%; background: var(--accent); border-radius: 3px; }

/* A card with an open drivers popover must paint above later sibling
   cards (each .glass card is its own stacking context) */
.card.pop-above { z-index: 55; }

/* ---------- SQCDP daily board ---------- */
.sqcdp-board {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
  align-items: start;
}
@media (max-width: 1200px) {
  .sqcdp-board { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
}
.sqcdp-col {
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  border-radius: var(--radius-lg);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}
.sqcdp-col-head { display: flex; align-items: center; gap: 10px; }
.sqcdp-col .pop-sec { padding: 8px 4px 2px; }
.sqcdp-col .tl-pop-row { padding: 6px 4px; }
.sqcdp-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}
@media (max-width: 1100px) {
  .sqcdp-row { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
}
.sqcdp-tile {
  display: flex; align-items: center; gap: 12px;
  text-align: left; font: inherit; color: inherit;
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  border-radius: var(--radius-lg);
  padding: 12px;
  cursor: pointer;
  min-width: 0;
  transition: border-color 0.15s;
}
.sqcdp-tile:hover { border-color: var(--accent); }
.sqcdp-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.sqcdp-letter {
  width: 46px; height: 46px; flex: none;
  border-radius: 13px;
  display: grid; place-items: center;
  color: #fff;
  font-size: 23px; font-weight: 800;
}
.sqcdp-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
.sqcdp-label { font-size: 13px; font-weight: 650; }
.sqcdp-sub { font-size: 11px; color: var(--text-muted); }
.sqcdp-days { display: grid; grid-template-columns: repeat(14, 1fr); gap: 2px; }
.sq-day { height: 5px; border-radius: 2px; }
.sq-day.sq-today { outline: 1px solid var(--text-secondary); outline-offset: 1px; }

/* ---------- Escalation: spotlight up, basket stays ---------- */
.esc-badge {
  display: inline-block;
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--accent);
  border: 1px solid var(--accent);
  border-radius: 5px;
  padding: 1px 5px;
  vertical-align: 1px;
}
.esc-ask {
  font-size: 11.5px; font-weight: 600;
  color: var(--text-primary);
  background: var(--accent-soft);
  border-radius: 6px;
  padding: 4px 8px;
  margin-top: 4px;
}

/* ---------- Lessons learned in detail sheets ---------- */
.lesson-card {
  background: var(--accent-soft);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  margin-top: 8px;
}
.lesson-text { font-size: 12.5px; line-height: 1.45; }
.lesson-meta { font-size: 10.5px; color: var(--text-muted); margin-top: 5px; }

/* ---------- Capacity: load vs. supply ---------- */
.cap-grid { display: flex; flex-direction: column; gap: 6px; }
.cap-team {
  display: grid;
  grid-template-columns: 150px repeat(2, 1fr);
  gap: 14px;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px solid var(--glass-inner-line);
}
.cap-team:last-child { border-bottom: 0; }
.cap-team-name { font-size: 12.5px; font-weight: 650; }
.cap-head {
  display: flex; justify-content: space-between;
  font-size: 10.5px; color: var(--text-muted);
  margin-bottom: 3px;
}
.cap-pct { font-variant-numeric: tabular-nums; }
.cap-bar {
  height: 12px;
  border-radius: 6px;
  background: var(--accent-soft);
  overflow: hidden;
  position: relative;
}
.cap-over { box-shadow: inset 0 0 0 1px var(--status-critical); }
.cap-demand { display: flex; height: 100%; gap: 1px; }
.cap-seg { background: var(--accent); opacity: 0.85; display: block; height: 100%; }
.cap-seg:nth-child(2n) { opacity: 0.6; }
.cap-seg:nth-child(3n) { opacity: 0.45; }
.cap-foot { font-size: 10px; color: var(--text-muted); margin-top: 3px; font-variant-numeric: tabular-nums; }
@media (max-width: 900px) {
  .cap-team { grid-template-columns: 1fr; gap: 6px; }
}

/* Saved cockpits: the user's own, promoted from a composed view */
.chip.save-chip {
  border-style: dashed;
  border-color: var(--accent);
  color: var(--accent);
}
.chip.save-chip:hover { background: var(--accent-soft); }
.chip.saved-chip::before {
  content: "✦";
  margin-right: 5px;
  opacity: 0.7;
}

/* ---------- Jarvis mode ---------- */
/* Why a generated widget is on the canvas */
.card-sub.ai-reason {
  background: var(--ai-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-weight: 550;
}
/* "View updated · N changes" note inside an assistant message */
.msg-viewupdate {
  display: block;
  margin-top: 8px;
  border: 1px solid var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font: 600 11px var(--font-ui);
  border-radius: 999px;
  padding: 5px 10px;
  cursor: pointer;
}
.msg-viewupdate:hover { background: var(--accent); color: #fff; }

/* Brief accent ring after a drill-down brings a card back into view */
@keyframes focus-flash-ring {
  from { box-shadow: 0 0 0 3px var(--accent); }
  to   { box-shadow: 0 0 0 3px transparent; }
}
.card.focus-flash { animation: focus-flash-ring 1.5s ease-out; }
@media (prefers-reduced-motion: reduce) {
  .card.focus-flash { animation: none; box-shadow: 0 0 0 2px var(--accent); }
}

/* ---------- AIP assist panel ---------- */
.aip-drawer {
  background: var(--glass-bg-strong);
  position: fixed;
  top: var(--gap); right: var(--gap); bottom: var(--gap);
  width: 380px;
  max-width: calc(100vw - 2 * var(--gap));
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 18px;
  gap: 12px;
  transform: translateX(calc(100% + 2 * var(--gap)));
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}
.aip-drawer.open { transform: translateX(0); }
.aip-head { display: flex; align-items: center; gap: 10px; }
.aip-head .titles { flex: 1; }
.aip-messages {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 4px 2px;
}
.msg {
  max-width: 90%;
  border-radius: var(--radius-lg);
  padding: 10px 14px;
  font-size: 13px;
  line-height: 1.45;
}
.msg.user {
  align-self: flex-end;
  background: var(--accent);
  color: #fff;
  border-bottom-right-radius: 6px;
}
.msg.assistant {
  align-self: flex-start;
  background: var(--glass-bg-strong);
  border: 1px solid var(--hairline);
  border-bottom-left-radius: 6px;
  color: var(--text-primary);
}
.aip-suggestions { display: flex; flex-wrap: wrap; gap: 6px; }
.aip-input-row { display: flex; gap: 8px; }
.aip-input-row input {
  flex: 1;
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font: 400 13px var(--font-ui);
}
.aip-input-row input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

/* ---------- Footer ---------- */
.footer {
  text-align: center;
  font-size: 11px;
  color: var(--text-muted);
  padding: 8px 0 16px;
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; }
}

/* ---------- Compact KPI tiles (dense review-board variant) ---------- */
.card.compact { padding: 14px 16px; gap: 8px; }
.card.compact .card-title { font-size: 12.5px; }
.card.compact .card-sub { display: none; }
.card.compact .kpi-value { font-size: 24px; }
.card.compact .kpi-unit { font-size: 12px; }
.card.compact .kpi-delta { font-size: 11.5px; }
.card.compact .kpi-delta .vs { display: none; }
.card.compact .kpi-spark { height: 26px; }
.card.compact .status-badge { padding: 4px 8px; font-size: 10px; }

/* ---------- Clickable widgets (drill-down) ---------- */
.clickable { cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; }
.clickable:hover { transform: translateY(-2px); }
.clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.list-item.clickable:hover { transform: none; background: var(--accent-soft); border-radius: var(--radius-sm); }

/* ---------- Detail sheet (drill-down modal) ---------- */
.sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(10, 12, 18, 0.35);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  display: grid;
  place-items: center;
  padding: 24px;
}
.sheet {
  background: var(--glass-bg-strong);
  width: min(720px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
/* When content exceeds max-height the sheet must scroll, not squeeze
   its children (a squeezed chart box overflows into the next section) */
.sheet > * {
  flex-shrink: 0;
}
.sheet-head { display: flex; align-items: flex-start; gap: 12px; }
.sheet-head .titles { flex: 1; min-width: 0; }
.sheet-title { font-size: 18px; font-weight: 700; }
.sheet-desc { font-size: 13px; line-height: 1.5; color: var(--text-secondary); }
.sheet-section-title {
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-top: 4px;
}
.sheet-chart { min-height: 240px; }
.bp-list { display: flex; flex-direction: column; gap: 8px; }
.bp-row { display: flex; align-items: center; gap: 10px; font-size: 12.5px; }
.bp-label { width: 100px; flex: none; color: var(--text-secondary); }
.bp-track {
  flex: 1;
  height: 12px;
  border-radius: 6px;
  background: var(--accent-soft);
  overflow: hidden;
}
.bp-fill { display: block; height: 100%; border-radius: 6px; background: var(--accent); }
.bp-value {
  width: 90px;
  flex: none;
  text-align: right;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.sheet-fields { display: flex; flex-direction: column; }
.sheet-field {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 2px;
  border-bottom: 1px solid var(--glass-inner-line);
  font-size: 13px;
}
.sheet-field:last-child { border-bottom: 0; }
.sheet-field span { color: var(--text-muted); }
.sheet-meta { display: flex; gap: 18px; font-size: 12px; color: var(--text-muted); flex-wrap: wrap; }
.sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-top: 1px solid var(--glass-inner-line);
  padding-top: 12px;
}
.sheet-foot .pill[disabled] { opacity: 0.6; cursor: default; }

/* ---------- Data-freshness foot ---------- */
.card-foot {
  font-size: 10.5px;
  color: var(--text-muted);
  border-top: 1px solid var(--glass-inner-line);
  padding-top: 8px;
  margin-top: auto;
}

/* ---------- KPI annotation (owner's note) ---------- */
.kpi-note {
  display: flex;
  gap: 7px;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--text-secondary);
  background: var(--accent-soft);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
}
.kpi-note-icon { flex: none; }
.sheet-note {
  display: flex;
  gap: 8px;
  font-size: 12.5px;
  line-height: 1.45;
  color: var(--text-secondary);
  background: var(--accent-soft);
  border-radius: var(--radius-md);
  padding: 10px 12px;
}
.sheet-note b { display: block; color: var(--text-primary); margin-bottom: 2px; }

/* ---------- Alerts ---------- */
.alert-count {
  position: absolute;
  top: -5px; right: -5px;
  min-width: 16px; height: 16px;
  border-radius: 8px;
  background: var(--status-critical);
  color: #fff;
  font: 700 10px/1 var(--font-ui);
  display: grid;
  place-items: center;
  padding: 0 4px;
}
.alerts-panel {
  position: fixed;
  top: 76px;
  right: var(--gap);
  width: 420px;
  max-width: calc(100vw - 2 * var(--gap));
  z-index: 120;
  padding: 16px 18px;
  background: var(--glass-bg-strong);
  display: none;
  flex-direction: column;
  gap: 8px;
}
.alerts-panel.open { display: flex; }
.card.alerted { box-shadow: var(--glass-shadow), 0 0 0 2px var(--status-critical); }
.alert-flag { color: var(--status-critical); font-size: 14px; flex: none; }

/* ---------- Personalisation (edit mode) ---------- */
.card.editing { position: relative; }
.card.hidden-widget { opacity: 0.35; }
.edit-remove {
  position: absolute;
  top: -10px; right: -10px;
  width: 28px; height: 28px;
  font-size: 13px;
  z-index: 5;
  background: var(--glass-bg-strong);
  box-shadow: var(--glass-shadow);
}

/* ---------- Boardroom mode ---------- */
body.boardroom .footer,
body.boardroom .context-row .meta { display: none; }
body.boardroom .context-row h1 { font-size: 32px; }
body.boardroom .card-title { font-size: 16px; }
body.boardroom .kpi-value { font-size: 44px; }
body.boardroom .card.compact .kpi-value { font-size: 30px; }
body.boardroom .kpi-delta { font-size: 15px; }
body.boardroom .list-item { font-size: 14.5px; }

/* ---------- Executive briefing (AIP) ---------- */
.card.briefing { border-left: 3px solid var(--accent); }
.briefing-headline { font-size: 15px; font-weight: 650; letter-spacing: -0.01em; }
.briefing-bullets {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-size: 13px;
  line-height: 1.45;
  color: var(--text-secondary);
}

/* ---------- User chip ---------- */
.user-chip { cursor: default; color: var(--text-secondary); }

/* ---------- KPI catalog ---------- */
.catalog-search {
  border: 1px solid var(--hairline);
  background: var(--glass-bg);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font: 400 13px var(--font-ui);
  width: 100%;
}
.catalog-search:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.sheet.catalog { width: min(640px, 100%); }

/* ---------- Action capture in the detail sheet ---------- */
.sheet-capture { display: flex; gap: 8px; }
.sheet-capture input {
  flex: 1;
  border: 1px solid var(--hairline);
  background: var(--glass-bg);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  padding: 9px 12px;
  font: 400 13px var(--font-ui);
}
.sheet-capture input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

/* ---------- Board-pack export (print) ---------- */
@media print {
  .ambient, .topbar, .footer, .aip-drawer, .alerts-panel,
  #cockpit-chips, .edit-remove { display: none !important; }
  body { background: #fff; }
  .glass {
    background: #fff;
    box-shadow: none;
    border: 1px solid #ddd;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .grid { gap: 10px; }
  .card { break-inside: avoid; }
}

/* ---------- Milestone timeline (tl-) ---------- */
.tl-wrap { position: relative; display: flex; flex-direction: column; overflow-x: auto; }
.tl-row { display: flex; align-items: stretch; min-height: 74px; }
.tl-axis { min-height: 22px; }
.tl-label {
  width: 150px; flex: none;
  font-size: 12px; font-weight: 550;
  color: var(--text-secondary);
  display: flex; align-items: center;
}
.tl-track { position: relative; flex: 1; min-width: 560px; margin-right: 20px; }
.tl-line {
  position: absolute; left: 0; right: 0; top: 50%;
  height: 1px; background: var(--grid-line);
}
.tl-month {
  position: absolute; transform: translateX(-50%);
  top: 2px; font-size: 10px; color: var(--text-muted); white-space: nowrap;
}
.tl-phase {
  position: absolute; top: 14%; height: 72%;
  background: var(--accent-soft);
  border-radius: 8px;
  overflow: hidden;
}
.tl-phase-label {
  position: absolute; top: 2px; left: 6px;
  font-size: 9.5px; font-weight: 600;
  letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--text-muted); white-space: nowrap;
  background: var(--glass-bg-strong);
  border-radius: 6px; padding: 1px 6px;
}
.tl-conn {
  position: absolute; top: 50%; height: 2px;
  transform: translateY(-50%);
  border-radius: 1px; opacity: 0.55;
}
.tl-baseline {
  position: absolute; top: 50%;
  width: 8px; height: 8px;
  transform: translate(-50%, -50%);
  border: 2px solid var(--text-muted);
  border-radius: 50%;
  background: var(--chart-surface);
}
.tl-target {
  position: absolute; top: 50%;
  width: 2px; height: 14px;
  transform: translate(-50%, -50%);
  background: var(--text-muted);
  border-radius: 1px;
}
.tl-item {
  position: absolute; top: 50%;
  transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  background: none; border: 0; padding: 0; cursor: pointer;
  font: inherit; color: inherit;
}
.tl-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
.tl-marker {
  width: 13px; height: 13px; flex: none;
  display: grid; place-items: center;
  color: #fff; font-size: 8px; font-weight: 700;
  border: 2px solid var(--chart-surface);
  box-sizing: content-box;
}
.tl-ms .tl-marker { transform: rotate(45deg); border-radius: 3px; }
.tl-ms .tl-marker { line-height: 1; }
.tl-ms .tl-marker:not(:empty) { transform: rotate(0); border-radius: 50%; }
.tl-gate .tl-marker { border-radius: 3px; }
/* Labels hang off the marker via absolute positioning so the marker
   itself always sits exactly on the lane line */
.tl-item-label {
  position: absolute; left: 50%; transform: translateX(-50%);
  font-size: 10.5px; font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
  max-width: 140px; overflow: hidden; text-overflow: ellipsis;
}
.tl-above .tl-item-label { bottom: calc(100% + 3px); }
.tl-below .tl-item-label { top: calc(100% + 3px); }
/* Near the track edges the label grows inward from the marker */
.tl-edge-l .tl-item-label { left: -2px; transform: none; }
.tl-edge-r .tl-item-label { left: auto; right: -2px; transform: none; }
.tl-today {
  position: absolute; top: 20px; bottom: 4px;
  width: 1px; background: var(--accent);
  opacity: 0.65; pointer-events: none;
}
.tl-today-label {
  position: absolute; top: 0; left: 4px;
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--accent);
  white-space: nowrap;
}

/* Legend keys for the timeline */
.tl-key { width: 10px; height: 10px; flex: none; display: grid; place-items: center; }
.tl-key-baseline { border: 2px solid var(--text-muted); border-radius: 50%; background: transparent; width: 8px; height: 8px; }
.tl-key-target { width: 2px; height: 12px; background: var(--text-muted); border-radius: 1px; }
.tl-key-forecast { background: var(--status-warning); transform: rotate(45deg); border-radius: 2px; }
.tl-key-gate { background: var(--status-warning); border-radius: 2px; }
.tl-key-achieved { background: var(--status-good); border-radius: 50%; color: #fff; font-size: 7px; font-weight: 700; }
.tl-key-phase { background: var(--accent-soft); border-radius: 3px; width: 14px; }

/* Slip badges (timeline list + detail sheet) */
.slip-bad { color: var(--delta-bad-text); font-weight: 600; }
.slip-good { color: var(--delta-good-text); font-weight: 600; }

/* ---------- Gantt engine additions ---------- */
.tl-body { position: relative; }
.tl-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.tl-sep { width: 1px; height: 18px; background: var(--hairline); margin: 0 6px; }

.tl-lane-name { display: flex; align-items: center; gap: 7px; font-weight: 600; }
.tl-lane-sub { display: block; font-size: 10.5px; color: var(--text-muted); margin-top: 2px; margin-left: 15px; }
.tl-caret {
  border: 0; background: none; cursor: pointer;
  color: var(--text-muted); font-size: 11px; padding: 0 2px;
}
.tl-caret:hover { color: var(--accent); }
.tl-label { display: block; align-self: center; }
.tl-subrow { min-height: 46px; }
.tl-subrow .tl-label { padding-left: 26px; }
.tl-lane-sub-name { font-size: 11px; color: var(--text-muted); font-weight: 500; }
.tl-more { position: absolute; top: 50%; transform: translateY(-50%); font-size: 11px; color: var(--text-muted); }

.tl-week {
  position: absolute; bottom: 0;
  width: 1px; height: 5px;
  background: var(--axis-line);
}

.tl-ghost { opacity: 0.4; border-style: dashed; }

/* Recovered gate: was red/amber at first evaluation, closed green —
   the positive signal gets a green halo around the marker */
.tl-recovered .tl-marker { box-shadow: 0 0 0 2px var(--status-good); }
.tl-key-recovered { box-shadow: 0 0 0 1.5px var(--chart-surface), 0 0 0 3px var(--status-good); }
.tl-lane-recovered { color: var(--delta-good-text); font-weight: 600; }

/* "Current only" view hides the shift marks, so the legend must not
   advertise them */
.legend.tl-clean .legend-shift { display: none; }

/* Attachment flags: tiny dots at the marker's shoulder — project log
   (accent) and linked KPI (series-7). Info only, never interactive. */
.tl-flags {
  position: absolute; top: -4px; right: -8px;
  display: flex; gap: 2px;
  pointer-events: none;
}
.tl-flag {
  width: 5px; height: 5px; border-radius: 50%;
  border: 1px solid var(--chart-surface);
}
.tl-flag-log { background: var(--accent); }
.tl-flag-kpi { background: var(--series-7); }
/* More than one input converges here; red when one of them already
   lands too late for the date this milestone is holding. */
.tl-flag-in { background: var(--text-muted); }
.tl-flag-in.tl-flag-late { background: var(--status-critical); }

/* Project-log category chips in the detail sheet */
.log-cat { flex: none; text-transform: capitalize; pointer-events: none; }
.log-cat-escalation { color: var(--delta-bad-text); }
.log-cat-decision { color: var(--accent); }

/* Forecast trail: fading ghost diamonds at past reported forecasts */
.tl-trail {
  position: absolute; top: 50%;
  width: 8px; height: 8px;
  transform: translate(-50%, -50%) rotate(45deg);
  background: var(--text-muted);
  border-radius: 2px;
}
.tl-key-trail {
  background: var(--text-muted); opacity: 0.5;
  transform: rotate(45deg); border-radius: 2px;
  width: 8px; height: 8px;
}

/* As-of replay slider */
.tl-asof { width: 110px; accent-color: var(--accent); }
.tl-asof-label {
  font-size: 11px; color: var(--text-muted);
  font-variant-numeric: tabular-nums; min-width: 44px;
}
.tl-asof-label.active { color: var(--accent); font-weight: 650; }
.tl-today.tl-asof-line { border-left: 1px dashed var(--accent); background: none; }

/* Density minimap: distribution over the full range + viewport box */
.tl-mini-row { min-height: 24px; }
.tl-mini-label {
  font-size: 9.5px; font-weight: 600;
  letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--text-muted);
}
.tl-mini {
  display: flex; align-items: flex-end; gap: 1px;
  height: 14px; align-self: center;
  cursor: pointer;
}
.tl-mini-bar { flex: 1; background: var(--axis-line); border-radius: 1px 1px 0 0; opacity: 0.7; }
.tl-mini-view {
  position: absolute; top: -2px; bottom: -2px;
  background: var(--accent-soft);
  border: 1px solid var(--accent);
  border-radius: 3px;
  opacity: 0.55;
  pointer-events: none;
}

/* Timeline free-text search, sized like a chip */
.tl-search {
  border: 1px solid var(--hairline);
  border-radius: 999px;
  background: transparent;
  color: var(--text-primary);
  font: 500 12px var(--font-ui);
  padding: 4px 10px;
  width: 120px;
  outline: none;
}
.tl-search:focus { border-color: var(--accent); }
.tl-search::placeholder { color: var(--text-muted); }

.tl-phase-fill {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: var(--accent);
  opacity: 0.14;
  border-radius: 8px 0 0 8px;
}

.tl-cluster {
  position: absolute; top: 50%;
  transform: translate(-50%, -50%);
  min-width: 22px; height: 22px;
  border-radius: 11px;
  border: 2px solid var(--chart-surface);
  color: #fff;
  font: 700 10px/1 var(--font-ui);
  display: grid; place-items: center;
  padding: 0 5px;
  cursor: pointer;
}
.tl-cluster:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.tl-key-cluster {
  background: var(--status-warning);
  border-radius: 8px; color: #fff;
  font-size: 7px; font-weight: 700;
  width: 16px;
}

.tl-popover {
  position: absolute;
  z-index: 60;
  width: 260px;
  max-height: 280px;
  overflow-y: auto;
  background: var(--glass-bg-strong);
  border-radius: var(--radius-md);
  padding: 6px;
  display: flex; flex-direction: column;
}
.tl-pop-row {
  display: flex; align-items: center; gap: 8px;
  border: 0; background: none; cursor: pointer;
  font: 500 12px var(--font-ui);
  color: var(--text-primary);
  padding: 7px 8px;
  border-radius: 8px;
  text-align: left;
}
.tl-pop-row:hover { background: var(--accent-soft); }
.tl-pop-title { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tl-pop-date { font-size: 11px; color: var(--text-muted); font-variant-numeric: tabular-nums; }

.tl-deps {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 3;
}
/* Hovering a milestone dims the overlay and lights its own links.
   Circles are the fan-in join dots — they dim and light with the
   paths they belong to. */
.tl-deps.deps-hover path,
.tl-deps.deps-hover circle { opacity: 0.12; }
.tl-deps path.hl, .tl-deps circle.hl { opacity: 1; stroke-width: 2; }
/* A driving edge is already 1.8–2.4 wide; the plain .hl width would
   make it *thinner* when highlighted. */
.tl-deps path.tl-dep-driving.hl { stroke-width: 2.6; }

.tl-body .tooltip { z-index: 70; }

/* Boardroom: exceptions only — labels stay for gates, serious & critical */
body.boardroom .tl-item-label { display: none; }
body.boardroom .tl-gate .tl-item-label,
body.boardroom .tl-s-serious .tl-item-label,
body.boardroom .tl-s-critical .tl-item-label { display: block; }

/* ---------- AI branding: ask bar, pills, explain, insights, EVM ---------- */
.ask-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 380px;
  max-width: 520px;
  min-width: 220px;
  background: var(--glass-bg-strong);
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  padding: 0 12px;
  background-clip: padding-box;
  position: relative;
}
.ask-bar::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: var(--ai-gradient);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.55;
  pointer-events: none;
}
.ask-bar:focus-within::before { opacity: 1; }
.ask-spark {
  background: var(--ai-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-size: 14px;
  flex: none;
}
.ask-bar input {
  flex: 1;
  border: 0;
  background: none;
  color: var(--text-primary);
  font: 400 13px var(--font-ui);
  padding: 9px 0;
  min-width: 0;
}
.ask-bar input:focus { outline: none; }
.ask-bar input::placeholder { color: var(--text-muted); }

.ai-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font: 700 9.5px/1 var(--font-ui);
  letter-spacing: 0.06em;
  color: #fff;
  background: var(--ai-gradient);
  border-radius: 999px;
  padding: 4px 8px;
  flex: none;
}

.explain-btn {
  width: 26px; height: 26px;
  border-radius: 9px;
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  cursor: pointer;
  font-size: 12px;
  flex: none;
  display: grid;
  place-items: center;
  padding: 0;
}
.explain-btn::before {
  content: "✦";
  background: var(--ai-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.explain-btn:hover { border-color: var(--accent); }
/* Hover hint: what the ✦ does, styled, with a short show delay */
.explain-btn { position: relative; }
.explain-btn::after {
  content: "Explain this widget — an AI summary grounded in the data currently in view";
  position: absolute;
  top: calc(100% + 6px); right: 0;
  z-index: 45;
  width: max-content; max-width: 220px;
  background: var(--glass-bg-strong);
  border: 1px solid var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--glass-shadow);
  padding: 7px 10px;
  font: 500 11px/1.45 var(--font-ui);
  color: var(--text-secondary);
  text-align: left;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-2px);
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.explain-btn:hover::after,
.explain-btn:focus-visible::after {
  opacity: 1;
  transform: none;
  transition-delay: 0.3s;
}
/* Once the explanation is open the hint would overlap it — hide it */
.explain-btn.pop-open::after { display: none; }
@media (prefers-reduced-motion: reduce) {
  .explain-btn::after { transition: none; transform: none; }
}
.explain-pop {
  position: absolute;
  top: 46px; right: 14px;
  z-index: 40;
  width: min(340px, calc(100% - 28px));
  background: var(--glass-bg-strong);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.explain-pop p { font-size: 12.5px; line-height: 1.5; color: var(--text-primary); }
.explain-foot { font-size: 10px; color: var(--text-muted); }
.card { position: relative; }

/* Insights feed */
.insight-list { display: flex; flex-direction: column; }
.insight {
  padding: 10px 2px;
  border-bottom: 1px solid var(--glass-inner-line);
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.insight:last-child { border-bottom: 0; }
.insight-head { display: flex; align-items: center; gap: 8px; }
.insight-kind {
  font: 600 10px/1 var(--font-ui);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.insight-title { font-size: 13px; font-weight: 650; }
.insight-text { font-size: 12px; line-height: 1.45; color: var(--text-secondary); }
.insight-sources { gap: 6px; }
.source-chip {
  padding: 4px 9px;
  font-size: 10.5px;
  color: var(--accent);
  border-color: var(--accent-soft);
}
.source-chip:hover { border-color: var(--accent); }
.msg-sources { margin-top: 8px; }

/* Toast for executed AI commands */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translate(-50%, 12px);
  z-index: 300;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--glass-bg-strong);
  border-radius: 999px;
  padding: 9px 16px;
  font-size: 12.5px;
  color: var(--text-primary);
  opacity: 0;
  transition: opacity 0.25s, transform 0.25s;
  pointer-events: none;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

/* EVM table */
.evm-wrap { overflow-x: auto; }
.evm-table { border-collapse: collapse; width: 100%; min-width: 760px; }
.evm-table th {
  font: 600 10.5px var(--font-ui);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-muted);
  text-align: right;
  padding: 8px 10px;
  border-bottom: 1px solid var(--hairline);
}
.evm-table th:first-child { text-align: left; }
.evm-table td {
  font: 500 12.5px var(--font-ui);
  font-variant-numeric: tabular-nums;
  text-align: right;
  padding: 10px;
  border-bottom: 1px solid var(--glass-inner-line);
  white-space: nowrap;
}
.evm-table td.evm-name { text-align: left; font-weight: 600; }
.evm-sub { display: block; font-size: 10.5px; font-weight: 500; color: var(--text-muted); margin-top: 1px; }
.evm-total td { font-weight: 700; border-top: 1px solid var(--hairline); border-bottom: 0; }
.evm-perf {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-weight: 650;
}

@media (max-width: 1200px) {
  .ask-bar { order: 10; flex-basis: 100%; max-width: none; }
}

/* ---------- Ops mode: honest liveliness ---------- */
.ops-clock {
  display: none;
  font: 500 12px/1.2 var(--font-ui);
  font-variant-numeric: tabular-nums;
  color: var(--text-secondary);
  white-space: nowrap;
  padding: 0 4px;
}
.ops-clock b { font-weight: 700; color: var(--text-primary); }
body.ops .ops-clock { display: block; }

/* Ticker band (bottom) */
.ticker {
  position: fixed;
  left: var(--gap); right: var(--gap); bottom: var(--gap);
  height: 40px;
  z-index: 90;
  overflow: hidden;
  display: none;
  align-items: center;
  border-radius: 999px;
  background: var(--glass-bg-strong);
}
body.ops .ticker { display: flex; }
body.ops .app { padding-bottom: 80px; }
body.ops .toast { bottom: 72px; }
.ticker-track {
  display: flex;
  align-items: center;
  gap: 34px;
  padding-left: 100%;
  white-space: nowrap;
  animation: ticker-scroll 40s linear infinite;
  will-change: transform;
}
.ticker:hover .ticker-track { animation-play-state: paused; }
@keyframes ticker-scroll {
  to { transform: translateX(-100%); }
}
.ticker-item {
  border: 0;
  background: none;
  cursor: pointer;
  font: 600 11.5px/1 var(--font-ui);
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  padding: 6px 2px;
}
.ticker-item:disabled { cursor: default; }
.ticker-item:hover:not(:disabled) { color: var(--text-primary); }
.t-crit { color: var(--status-critical); }
.t-warn { color: var(--delta-bad-text); }
.t-ok   { color: var(--delta-good-text); }
.t-ai {
  background: var(--ai-gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.t-meta { color: var(--text-muted); }

/* Refresh sweep at the very top */
#refresh-bar {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  width: 0;
  background: var(--ai-gradient);
  z-index: 400;
  opacity: 0;
}
#refresh-bar.run {
  opacity: 1;
  animation: refresh-sweep 0.9s ease-out;
}
@keyframes refresh-sweep {
  from { width: 0; }
  to   { width: 100%; }
}

/* Pulsing ring on alerted tiles (ops only) */
body.ops .card.alerted {
  animation: alert-pulse 2.4s ease-in-out infinite;
}
@keyframes alert-pulse {
  0%, 100% { box-shadow: var(--glass-shadow), 0 0 0 2px var(--status-critical); }
  50%      { box-shadow: var(--glass-shadow), 0 0 0 5px rgba(208, 59, 59, 0.35); }
}

/* Roaming spotlight scan */
body.ops .card.spotlight {
  box-shadow: var(--glass-shadow), 0 0 0 2px var(--accent), 0 0 28px rgba(42, 120, 214, 0.28);
  transition: box-shadow 0.6s ease;
}

/* Widget entrance cascade */
body.ops #grid .card {
  animation: card-in 0.5s ease-out backwards;
}
body.ops #grid .card:nth-child(1)  { animation-delay: 0.02s; }
body.ops #grid .card:nth-child(2)  { animation-delay: 0.06s; }
body.ops #grid .card:nth-child(3)  { animation-delay: 0.10s; }
body.ops #grid .card:nth-child(4)  { animation-delay: 0.14s; }
body.ops #grid .card:nth-child(5)  { animation-delay: 0.18s; }
body.ops #grid .card:nth-child(6)  { animation-delay: 0.22s; }
body.ops #grid .card:nth-child(7)  { animation-delay: 0.26s; }
body.ops #grid .card:nth-child(8)  { animation-delay: 0.30s; }
body.ops #grid .card:nth-child(n+9) { animation-delay: 0.34s; }
@keyframes card-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}

/* Live dot on the ops toggle while active */
body.ops #ops-toggle { color: var(--status-good); }

@media (prefers-reduced-motion: reduce) {
  .ticker-track { animation: none; padding-left: 0; flex-wrap: wrap; }
  body.ops .card.alerted, body.ops #grid .card { animation: none; }
  #refresh-bar.run { animation: none; opacity: 0; }
}

/* ---------- Operating-system layer: inbox, decisions, lifecycle, review ---------- */
.inbox-card { border-left: 3px solid var(--accent); }
.inbox-count {
  min-width: 24px; height: 24px;
  border-radius: 12px;
  background: var(--accent);
  color: #fff;
  font: 700 12px/1 var(--font-ui);
  display: grid;
  place-items: center;
  padding: 0 7px;
  flex: none;
}

.decision-mark {
  width: 26px; height: 26px;
  border-radius: 9px;
  background: var(--accent-soft);
  color: var(--accent);
  font: 700 13px/1 var(--font-ui);
  display: grid;
  place-items: center;
  flex: none;
}

.alert-row .alert-actions { display: flex; gap: 6px; flex: none; }
.lc-btn { padding: 5px 10px; font-size: 11px; }
.alert-resolved { opacity: 0.55; }
.lc-new { color: var(--delta-bad-text); }
.lc-acknowledged { color: var(--status-warning); }
.lc-resolved { color: var(--delta-good-text); }
.alerts-panel { width: 480px; }

/* Review bar */
.review-bar {
  display: none;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border-left: 3px solid var(--status-critical);
  flex-wrap: wrap;
}
.review-bar.open { display: flex; }
.review-status {
  font-size: 12.5px;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}
.review-status .ai-pill { background: var(--status-critical); }
.review-form { display: flex; gap: 8px; flex: 1; min-width: 280px; }
.review-form input {
  flex: 1;
  border: 1px solid var(--hairline);
  background: var(--glass-bg-strong);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  padding: 9px 12px;
  font: 400 13px var(--font-ui);
  min-width: 0;
}
.review-form input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.review-end { border-color: var(--status-critical); color: var(--delta-bad-text); font-weight: 600; }

/* Minutes sheet */
.minutes {
  font: 12.5px/1.6 ui-monospace, "SF Mono", Consolas, monospace;
  color: var(--text-primary);
  background: var(--glass-bg);
  border: 1px solid var(--glass-inner-line);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  white-space: pre-wrap;
  overflow-x: auto;
}

/* ---------- AI-composed answer view ---------- */
.answer-chip b { font-weight: 700; margin-left: 4px; opacity: 0.7; }
.answer-question {
  font-size: 16px;
  font-weight: 650;
  letter-spacing: -0.01em;
}

/* ---------- Feedback & KPI request forms ---------- */
.sheet-form { display: flex; flex-direction: column; gap: 10px; }
.sheet-form input[type="text"], .sheet-form textarea {
  border: 1px solid var(--hairline);
  background: var(--glass-bg);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  font: 400 13px/1.45 var(--font-ui);
  width: 100%;
  resize: vertical;
}
.sheet-form input:focus-visible, .sheet-form textarea:focus-visible {
  outline: 2px solid var(--accent); outline-offset: 1px;
}
.sheet-form-row { display: flex; gap: 8px; }
.sheet-form-row input { min-width: 0; }
.sheet-form-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.catalog-bar { display: flex; gap: 8px; align-items: center; }
.catalog-bar .catalog-search { flex: 1; }

/* ---------- Skeletons & widget errors (hookup readiness) ---------- */
.card.skeleton { gap: 14px; min-height: 150px; }
.sk-line {
  border-radius: 8px;
  background: linear-gradient(90deg,
    var(--glass-inner-line) 25%, var(--accent-soft) 50%, var(--glass-inner-line) 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
.sk-title { width: 45%; height: 14px; }
.sk-value { width: 30%; height: 30px; }
.sk-body  { width: 100%; height: 44px; }
@keyframes sk-shimmer { to { background-position: -200% 0; } }
@media (prefers-reduced-motion: reduce) { .sk-line { animation: none; } }

.widget-error { border-left: 3px solid var(--status-critical); }
.widget-error .widget-retry { align-self: flex-start; }

/* ---------- AI grounding contract & answer rating ---------- */
.ungrounded-pill {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 8px; padding: 4px 10px;
  font-size: 11.5px; font-weight: 600; border-radius: 999px;
  color: var(--status-warning);
  border: 1px solid color-mix(in srgb, var(--status-warning) 45%, transparent);
  background: color-mix(in srgb, var(--status-warning) 10%, transparent);
}
.msg-rate {
  display: flex; gap: 6px; margin-top: 8px;
  font-size: 11.5px; color: var(--text-muted);
}
.msg-rate .rate-btn { padding: 2px 10px; font-size: 13px; line-height: 1.6; }
